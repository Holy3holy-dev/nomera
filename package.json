{
  "name": "h3h-nomera",
  "version": "0.4.4-5",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "check": "node scripts/check.cjs",
    "assets": "node scripts/release-assets.cjs",
    "models:stage": "node scripts/optimize-car-models.cjs",
    "models:apply": "node scripts/optimize-car-models.cjs --apply",
    "models:verify": "node --test tests/glb-lossless-optimization.test.cjs",
    "lod:build": "node scripts/build-vehicle-lods.cjs",
    "lod:verify": "node --test tests/vehicle-lod.test.cjs",
    "lod:qa": "node scripts/authors-vehicle-lod-qa.cjs",
    "test:browser": "node scripts/browser-smoke.cjs",
    "admin:hash": "node scripts/hash-admin-password.cjs",
    "build": "node scripts/build.cjs",
    "serve": "node scripts/serve.cjs",
    "authors:build": "node scripts/authors-build.cjs",
    "build:authors": "node scripts/release-assets.cjs && node scripts/authors-build.cjs && node scripts/build.cjs --authors",
    "authors:serve": "node scripts/authors-build.cjs && node scripts/authors-serve.cjs",
    "authors:qa": "node scripts/authors-qa.cjs",
    "textures:build": "node scripts/build-mobile-textures.cjs",
    "textures:verify": "node --test tests/mobile-textures-and-response.test.cjs",
    "textures:qa": "node scripts/authors-mobile-texture-qa.cjs",
    "player:qa": "node scripts/authors-player-render-qa.cjs && node scripts/authors-player-race-qa.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "firebase-admin": "^13.4.0"
  },
  "devDependencies": {
    "meshoptimizer": "0.25.0",
    "playwright": "1.62.1",
    "sharp": "0.34.5"
  }
}
